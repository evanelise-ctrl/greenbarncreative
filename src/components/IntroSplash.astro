<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 90% 40% at 70% 0%, rgba(59, 106, 86, 0.28), transparent 65%),
      #211e2c;
  }
  .intro.done {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s ease, visibility 0s linear 0.7s;
  }
  .intro.skip { display: none; }
  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .intro-barn {
    width: 150px;
    height: auto;
    clip-path: inset(100% 0 0 0);
    animation: barnReveal 1s cubic-bezier(0.6, 0, 0.2, 1) 0.2s forwards;
  }
  .intro-welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: fadeUp 0.6s ease 1.2s forwards;
  }
  .intro-hi {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 20px;
    color: rgba(251, 247, 226, 0.6);
  }
  .intro-word { width: 210px; height: auto; display: block; }
  @keyframes barnReveal { to { clip-path: inset(0 0 0 0); } }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-barn { clip-path: none; animation: none; }
    .intro-welcome { opacity: 1; animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var intro = document.getElementById("intro");
    if (!intro) return;
    if (sessionStorage.getItem("gb-intro-seen")) {
      intro.classList.add("skip");
      return;
    }
    document.documentElement.style.overflow = "hidden";
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var hold = reduce ? 900 : 2400;
    function dismiss() {
      intro.classList.add("done");
      document.documentElement.style.overflow = "";
      sessionStorage.setItem("gb-intro-seen", "1");
    }
    var timer = setTimeout(dismiss, hold);
    intro.addEventListener("click", function () {
      clearTimeout(timer);
      dismiss();
    });
  })();
</script>