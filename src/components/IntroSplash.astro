<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 90% 40% at 70% 0%, rgba(59, 106, 86, 0.28), transparent 65%),
      #211e2c;
  }
  .intro.done {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }
  .intro.skip { display: none; }

  .intro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .intro-barn { width: 150px; height: auto; overflow: visible; }
  .barn-draw path {
    fill: none;
    stroke: #fbf7e2;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke-dashoffset 1.4s ease;
  }
  .barn-fill path { fill: #fbf7e2; }
  .barn-fill { opacity: 0; transition: opacity 0.6s ease; }
  .intro.filled .barn-fill { opacity: 1; }

  .intro-word-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .intro-hi {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-size: 20px;
    color: rgba(251, 247, 226, 0.6);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .intro-word {
    width: 210px;
    height: auto;
    display: block;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s ease;
  }
  .intro.worded .intro-hi { opacity: 1; }
  .intro.worded .intro-word { clip-path: inset(0 0 0 0); }

  .intro-enter {
    margin-top: 10px;
    padding: 12px 28px;
    border: 1px solid rgba(251, 247, 226, 0.3);
    border-radius: 2px;
    background: transparent;
    color: #fbf7e2;
    font-family: "Public Sans", system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.5s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .intro-enter:hover { background: rgba(251, 247, 226, 0.08); border-color: rgba(251, 247, 226, 0.5); }
  .intro.ready .intro-enter { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .barn-draw path,
    .intro-word,
    .intro-hi,
    .intro-enter { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var intro = document.getElementById("intro");
    if (!intro) return;
    var enter = document.getElementById("intro-enter");

    function dismiss() {
      intro.classList.add("done");
      document.documentElement.style.overflow = "";
      sessionStorage.setItem("gb-intro-seen", "1");
    }

    if (sessionStorage.getItem("gb-intro-seen")) {
      intro.classList.add("skip");
      return;
    }

    document.documentElement.style.overflow = "hidden";
    enter.addEventListener("click", dismiss);

    var paths = intro.querySelectorAll(".barn-draw path");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce) {
      paths.forEach(function (p) { p.style.strokeDasharray = "none"; });
      intro.classList.add("filled", "worded", "ready");
      return;
    }

    paths.forEach(function (p) {
      var len = p.getTotalLength();
      p.style.strokeDasharray = len;
      p.style.strokeDashoffset = len;
    });

    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        paths.forEach(function (p, i) {
          p.style.transitionDelay = (i * 0.3) + "s";
          p.style.strokeDashoffset = "0";
        });
      });
    });

    setTimeout(function () { intro.classList.add("filled"); }, 2000);
    setTimeout(function () { intro.classList.add("worded"); }, 2700);
    setTimeout(function () { intro.classList.add("ready"); }, 3900);
  })();
</script>