---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Services — Greenbarn Creative Co."
  description="Small business brand support and event coverage. Take the whole package or just the pieces you need."
  path="/services"
  ogDescription="Brand support and event coverage from a creative studio in Dearborn."
>

<main>
  <div class="wrap">

    <header class="page-head">
      <p class="eyebrow">Services</p>
      <h1>Two ways to<br>work together.</h1>
      <p>
        A creative studio in Dearborn. We shoot, we design, we cut, we ship.
        Take a whole package or just the pieces you need.
      </p>
    </header>

    <!-- ── SERVICE ONE ── -->
    <section class="service">
      <div class="service-head">
        <div>
          <p class="service-num">Service one</p>
          <h2>Small business<br>brand support.</h2>
        </div>
        <div class="service-intro">
          For a business that needs to look established before it feels like one.
          We build the whole visual identity, from the logo through the website to
          the signs on the table at a market, and hand it over so it keeps working
          without us.
          <span class="flex-note">Take all of it, or start with one piece.</span>
        </div>
      </div>

      <div class="tiles">
        <div class="tile">
          <h3>Brand kit</h3>
          <p>Logo, type, color, and a guide so everything stays consistent as you grow.</p>
        </div>
        <div class="tile">
          <h3>Website</h3>
          <p>Designed, built, and live, with everything a customer needs to decide.</p>
        </div>
        <div class="tile">
          <h3>Hero video</h3>
          <p>One short film for the top of your site and the front of your feed.</p>
        </div>
        <div class="tile">
          <h3>Brand photography</h3>
          <p>Product, people, and place, shot to match the identity rather than fight it.</p>
        </div>
        <div class="tile">
          <h3>Physical materials</h3>
          <p>Signage, packaging, cards, and print, prepared and ready for the printer.</p>
        </div>
        <div class="tile">
          <h3>Social content</h3>
          <p>A batch of posts and short clips you can schedule out over months.</p>
        </div>
        <div class="tile">
          <h3>Asset library</h3>
          <p>Every file organized and handed over. Yours to keep and reuse.</p>
        </div>
      </div>

      <div class="service-foot">
        <p class="proof">
          See it in practice:
          <a href="/work/e3-refillery">e3 Refillery</a> and
          <a href="/work/drnaumann">Ilka Naumann, M.D.</a>
        </p>
        <a class="btn" href="#contact">Start a project</a>
      </div>
    </section>

    <!-- ── SERVICE TWO ── -->
    <section class="service">
      <div class="service-head">
        <div>
          <p class="service-num">Service two</p>
          <h2>Event<br>coverage.</h2>
        </div>
        <div class="service-intro">
          One or two of us on site for the day, working quietly and staying out of
          the way. You get finished work back fast enough for it to still be timely,
          cut for wherever it needs to go.
          <span class="flex-note">Pick one, or have us cover both.</span>
        </div>
      </div>

      <div class="tiles">
        <div class="tile">
          <h3>Video</h3>
          <p>An edited film of the day, plus short vertical cuts for social.</p>
        </div>
        <div class="tile">
          <h3>Photo</h3>
          <p>A finished gallery, color corrected and delivered on a quick turnaround.</p>
        </div>
        <div class="tile">
          <h3>Both</h3>
          <p>Two of us covering the whole thing, so nothing gets missed either way.</p>
        </div>
      </div>

      <div class="service-foot">
        <p class="proof">
          See it in practice:
          <a href="/work/detroit-activations">Detroit Activations</a>
        </p>
        <a class="btn" href="#contact">Check availability</a>
      </div>
    </section>

  </div>
</main>

</Layout>
