---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Ilka Naumann, M.D. — Greenbarn Creative Co."
  description="Practice identity, patient-facing website, and film for Ilka Naumann, M.D., a neuro-otologist in Metro Detroit."
  path="/work/drnaumann"
  ogDescription="Everything a patient needs before they decide."
  ogImage="https://greenbarncreative.com/work/drnaumann/ilka-og.jpg"
  ogType="article"
>

<!-- ── HERO ──
     hero.mp4 with hero-poster.jpg as the first frame and reduced-motion fallback. -->
<header class="hero">
  <img src="/work/drnaumann/ilka-hero-poster.jpg" alt="Ilka Naumann, M.D.">
  <video autoplay muted loop playsinline poster="/work/drnaumann/ilka-hero-poster.jpg">
    <source src="/work/drnaumann/ilka-hero.mp4" type="video/mp4">
  </video>
  <div class="hero-title">
    <div class="wrap">
      <p class="eyebrow">Ilka Naumann, M.D.</p>
      <h1>Trust, built before<br>the first visit.</h1>
    </div>
  </div>
</header>

<main>
  <div class="wrap">

    <!-- ── META ── -->
    <section class="meta">
      <div>
        <p class="label">Client</p>
        <p class="value">Ilka Naumann, M.D.</p>
      </div>
      <div>
        <!-- Set the real year or range. -->
        <p class="label">Year</p>
        <p class="value">2025 to 2026</p>
      </div>
      <div>
        <p class="label">Scope</p>
        <p class="value">Brand identity, typography, website design and build, film</p>
      </div>
    </section>

    <!-- ── SETUP ── -->
    <p class="setup">
      A neuro-otologist and skull base surgeon needed a practice identity that
      reads as precise without feeling cold. Restrained typography, a patient
      facing site covering credentials, areas of expertise, and what to expect,
      and a patient testimonial film. Built for the moment someone is deciding
      on a surgeon.
    </p>

    <!-- ── IDENTITY AND SITE ── -->
    <section class="run">
      <p class="run-label">Identity and site</p>

      <!-- Type specimen, letterboxed so nothing crops. -->
      <figure class="r-wide sheet">
        <img src="/work/drnaumann/ilka-type.jpg" alt="Ilka Naumann practice typography and identity">
      </figure>

      <div class="pair">
        <figure class="r-tall"><img src="/work/drnaumann/ilka-headshot.jpg" alt="Ilka Naumann, M.D."></figure>
        <figure class="r-tall"><img src="/work/drnaumann/ilka-section-01.jpg" alt="Ilka Naumann website section"></figure>
      </div>

      <!-- Integrative medicine wheel. Silent loop, presented like a still. -->
      <figure class="r-wide sheet">
        <video class="loop" autoplay muted loop playsinline>
          <source src="/work/drnaumann/ilka-wheel.mp4" type="video/mp4">
        </video>
      </figure>

      <a class="btn" href="https://inotology.com" target="_blank" rel="noopener">
        Visit the live site <span aria-hidden="true">&#8599;</span>
      </a>
    </section>

    <!-- ── PATIENT STORY ── -->
    <section class="run">
      <p class="run-label">Patient story</p>

      <figure class="r-play">
        <video controls playsinline preload="metadata" poster="/work/drnaumann/ilka-hero-poster.jpg">
          <source src="/work/drnaumann/ilka-testimonial.mp4" type="video/mp4">
        </video>
      </figure>
    </section>

  </div>

  <!-- ── NEXT PROJECT ── -->
  <div class="wrap">
    <a class="next" href="/work/bedrock">
      <div class="inner">
        <div>
          <p class="label">Next project</p>
          <h2>Bedrock</h2>
        </div>
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </div>
    </a>
  </div>
</main>

</Layout>
